{
  "name": "dincox-shopee-livestream-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && npx electron-builder"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide": "^0.475.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.1.1",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.dincox.shopeelivestudio",
    "productName": "DinCox Shopee Live Studio",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron.js",
      "public/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "public/assets/presenter_female.png"
    }
  }
}
